{
  "name": "erix-agent",
  "version": "0.29.0",
  "description": "Headless coding-agent runtime for unattended, host-scheduled use: zero-dependency, dual-protocol streaming, tool loop, context compaction, checkpoint/resume. The CLI is a verifier/debugger.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "erix": "bin/cli.js"
  },
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "bin",
    "skills",
    "README.md",
    "README_cn.md",
    "CHANGELOG.md",
    "docs/host-consumer-contract.md",
    "docs/host-consumer-contract_cn.md",
    "docs/host-upgrade-guide-0.6.0.md",
    "docs/host-upgrade-guide-0.12.0.md",
    "docs/host-upgrade-guide-0.14.0.md",
    "test/contract/assembly-port.js",
    "test/contract/execute-tool.js",
    "test/contract/index.js",
    "test/contract/model-config-provider.js",
    "test/contract/notes-store.js",
    "test/contract/termination-payload.js",
    "test/contract/transcript-store.js",
    "LICENSE",
    "docs/host-upgrade-guide-0.15.0.md",
    "docs/host-upgrade-guide-0.16.0.md",
    "test/contract/engine-api.js",
    "docs/host-upgrade-guide-0.17.0.md",
    "test/contract/file-tools.js",
    "test/contract/skills-loader.js",
    "test/contract/tool-result-envelope.js",
    "test/helpers/tmp.js",
    "docs/host-upgrade-guide-0.18.0.md",
    "docs/host-upgrade-guide-0.18.0_cn.md",
    "docs/host-upgrade-guide-0.19.0.md",
    "docs/host-upgrade-guide-0.19.0_cn.md",
    "docs/host-upgrade-guide-0.20.0.md",
    "docs/host-upgrade-guide-0.20.0_cn.md",
    "docs/host-upgrade-guide-0.21.0.md",
    "docs/host-upgrade-guide-0.21.0_cn.md",
    "docs/host-upgrade-guide-0.22.0.md",
    "docs/host-upgrade-guide-0.22.0_cn.md",
    "docs/host-upgrade-guide-0.23.0.md",
    "docs/host-upgrade-guide-0.23.0_cn.md",
    "docs/host-upgrade-guide-0.24.0.md",
    "docs/host-upgrade-guide-0.24.0_cn.md",
    "docs/host-upgrade-guide-0.25.0.md",
    "docs/host-upgrade-guide-0.25.0_cn.md",
    "docs/host-upgrade-guide-0.26.0.md",
    "docs/host-upgrade-guide-0.26.0_cn.md",
    "docs/host-upgrade-guide-0.27.0.md",
    "docs/host-upgrade-guide-0.27.0_cn.md",
    "docs/host-upgrade-guide-0.28.0.md",
    "docs/host-upgrade-guide-0.28.0_cn.md",
    "docs/host-upgrade-guide-0.29.0.md",
    "docs/host-upgrade-guide-0.29.0_cn.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErixWong/erix-agent.git"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./tools": {
      "types": "./src/tools/index.d.ts",
      "default": "./src/tools/index.js"
    },
    "./contract-tests": "./test/contract/index.js"
  },
  "scripts": {
    "test": "node --test",
    "soak": "node scripts/soak.mjs",
    "check": "node --check src/index.js",
    "check:syntax": "node scripts/syntax-check.mjs",
    "types:build": "node scripts/build-types.mjs",
    "check:types": "node scripts/type-check-ratchet.mjs",
    "check:types:strict": "node scripts/type-check-ratchet.mjs --strict",
    "check:types-build": "node scripts/build-types.mjs --check",
    "prepack": "node scripts/build-types.mjs",
    "check:docs": "node scripts/docs-drift-check.mjs && node scripts/docs-sync-check.mjs",
    "check:docs:strict": "node scripts/docs-drift-check.mjs --strict",
    "check:docs-spelling": "node scripts/retired-spelling-scan.mjs --strict",
    "check:agents-directives": "node scripts/agents-directive-scan.mjs --strict && node scripts/agents-directive-scan.mjs --verify scripts/agents-directive-scan.mjs",
    "check:docs-examples": "node --test test/doc-examples.test.js",
    "check:pack-links": "node scripts/pack-link-check.mjs",
    "check:test-summary": "node scripts/suite-summary-reconcile.mjs",
    "check:release": "node scripts/release-check.mjs",
    "check:release:real": "node scripts/release-real-check.mjs",
    "check:cli-real": "node scripts/cli-real-smoke.mjs",
    "check:tests": "node scripts/test-hygiene-check.mjs",
    "check:inventory": "node scripts/flat-count-inventory.mjs . --verify test/compat-pin-inventory.md",
    "check:config-leaf-values": "node scripts/config-leaf-value-probe.mjs --verify docs/config-leaf-value-status.md docs/config-leaf-value-status_cn.md",
    "check:mutation": "node scripts/mutation-sample-check.mjs --verify test/mutation-samples.md",
    "check:mutation:run": "node scripts/mutation-sample-check.mjs --run test/mutation-samples.md",
    "check:exports": "node scripts/export-consumer-check.mjs",
    "check:exports:deprecated": "node scripts/deprecated-export-check.mjs",
    "check:final-guard-probe": "node scripts/final-guard-probe.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
