{
  "name": "erix-agent",
  "version": "0.2.0-rc",
  "description": "自研无头编码 agent（headless agent）：零依赖 LLM agent 运行时（双协议流式 + 工具循环 + 上下文压缩 + checkpoint），面向无人值守、宿主调度场景；CLI 为验证/调试器",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "erix": "bin/cli.js"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "test/contract"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErixWong/erix-agent.git"
  },
  "exports": {
    ".": "./src/index.js",
    "./tools": "./src/tools/index.js",
    "./contract-tests": "./test/contract/index.js"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/index.js"
  },
  "license": "UNLICENSED"
}
